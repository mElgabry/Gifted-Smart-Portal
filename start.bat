@echo off
chcp 65001 >nul
title بوابة الإدارة العامة للموهوبين والتعلم الذكي

echo ===================================================================
echo     بوابة الإدارة العامة للموهوبين والتعلم الذكي
echo     وزارة التربية والتعليم والتعليم الفني - جمهورية مصر العربية
echo ===================================================================
echo  جاري تشغيل المنظومة مع تفعيل الحفظ التلقائي في المجلد...
echo ===================================================================

cd /d "%~dp0"

:: 1. محاولة تشغيل بايثون
python --version >nul 2>&1
if %errorlevel% == 0 (
    echo [OK] تم العثور على بايثون، جاري تشغيل الخادم...
    python server.py
    goto finish
)

py --version >nul 2>&1
if %errorlevel% == 0 (
    echo [OK] تم العثور على بايثون، جاري تشغيل الخادم...
    py server.py
    goto finish
)

python3 --version >nul 2>&1
if %errorlevel% == 0 (
    echo [OK] تم العثور على بايثون، جاري تشغيل الخادم...
    python3 server.py
    goto finish
)

:: 2. إذا لم يكن بايثون مثبت، استخدام باورشيل ويندوز المدمج
echo [تنبيه] بايثون غير مثبت، جاري التشغيل عبر مشغل ويندوز الداخلي (PowerShell)...
powershell.exe -NoProfile -ExecutionPolicy Bypass -File "%~dp0server.ps1"
if %errorlevel% == 0 goto finish

:: 3. في حال تعذر تشغيل الخادم، فتح الموقع مباشرة في المتصفح
echo [تنبيه] جاري فتح الموقع في المتصفح مباشرة...
start "" "%~dp0index.html"

:finish
